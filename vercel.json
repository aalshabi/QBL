{
  "crons": [
    {
      "path": "/api/cron/daily-temperature-report",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cold-chain-watch",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cold-chain-poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-confirmations",
      "schedule": "*/5 * * * *"
    }
  ],
  "buildCommand": "node scripts/vercel-build.mjs"
}
