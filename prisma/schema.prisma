// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  OPS_MANAGER
  DISPATCHER
  COURIER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ClientSector {
  FOOD_SUPPLIER
  PHARMACY_CLINIC
  RESTAURANT_CAFE
  RETAIL
  HOTEL_HOSPITAL
  ECOMMERCE
}

enum CourierStatus {
  AVAILABLE
  ON_TASK
  LATE
  OFFLINE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

enum OrderStatus {
  CREATED
  PENDING_APPROVAL
  ASSIGNED
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  POSTPONED
  RETURNED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MADA
  VISA
  MASTER
  PREPAID
}

enum CodStatus {
  WITH_COURIER
  RECEIVED
  SORTED
  EXPORTED
  SETTLED
}

enum CodSettlementStatus {
  SORTED
  EXPORTED
  DELIVERED
}

enum ExpenseType {
  DRIVER
  HUB
  PARTNER
  OTHER
}

enum TemperatureStatus {
  NORMAL
  WARNING
  CRITICAL
  NOT_AVAILABLE
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  INTERNAL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum AuditAction {
  ORDER_CREATED
  ORDER_ASSIGNED
  ORDER_REASSIGNED
  STATUS_CHANGED
  OTP_GENERATED
  OTP_RESENT
  OTP_VERIFIED
  OTP_FAILED
  OTP_MANUAL_OVERRIDE
  LOCATION_PING
  TEMPERATURE_READING
  POD_CAPTURED
}

enum ProofType {
  OTP
  SIGNATURE
  PHOTO
  MANUAL_OVERRIDE
}

model Company {
  id             String   @id @default(cuid())
  officialName   String
  tradeName      String
  abbreviation   String
  sector         String
  headquarters   String
  foundedYear    Int
  website        String
  generalEmail   String
  salesEmail     String
  opsEmail       String
  billingEmail   String
  generalManager String
  managerEmail   String
  address        String
  crNumber       String
  unifiedNumber  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  ownedCases   OperationalCase[] @relation("CaseOwner")
  backupCases  OperationalCase[] @relation("CaseBackup")
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  phone        String?
  passwordHash String
  status       UserStatus        @default(ACTIVE)
  roles        UserRole[]
  courier      Courier?
  client       ClientAccount?
  auditLogs    AuditLog[]        @relation("AuditActor")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Customer {
  id        String          @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String
  latitude  Decimal         @db.Decimal(9, 6)
  longitude Decimal         @db.Decimal(9, 6)
  sector    ClientSector
  orders    DeliveryOrder[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ClientAccount {
  cases          OperationalCase[]
  id             String            @id @default(cuid())
  userId         String?           @unique
  companyName    String
  contactName    String
  contactEmail   String
  contactPhone   String
  sector         ClientSector
  slaMinutes     Int               @default(120)
  billingEmail   String?
  user           User?             @relation(fields: [userId], references: [id])
  orders         DeliveryOrder[]
  codSettlements CodSettlement[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Courier {
  id             String          @id @default(cuid())
  userId         String?         @unique
  employeeCode   String          @unique
  displayName    String
  phone          String
  status         CourierStatus   @default(AVAILABLE)
  vehicleId      String?         @unique
  hubId          String?
  user           User?           @relation(fields: [userId], references: [id])
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  hub            Hub?            @relation(fields: [hubId], references: [id])
  orders         DeliveryOrder[]
  pings          LocationPing[]
  codCollections CodCollection[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Vehicle {
  id              String               @id @default(cuid())
  plateNumber     String               @unique
  label           String
  make            String
  model           String
  year            Int
  coldRangeMin    Decimal              @db.Decimal(5, 2)
  coldRangeMax    Decimal              @db.Decimal(5, 2)
  supportsFrozen  Boolean              @default(false)
  status          VehicleStatus        @default(ACTIVE)
  insuranceExpiry DateTime?
  licenseExpiry   DateTime?
  courier         Courier?
  orders          DeliveryOrder[]
  temperatures    TemperatureReading[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model DeliveryOrder {
  cases                OperationalCase[]
  id                   String               @id @default(cuid())
  publicCode           String               @unique
  reference            String               @unique
  barcode              String?              @unique
  clientAccountId      String
  customerId           String
  courierId            String?
  vehicleId            String?
  hubId                String?
  status               OrderStatus          @default(CREATED)
  codAmount            Decimal?             @db.Decimal(10, 2)
  deliveryFee          Decimal?             @db.Decimal(10, 2)
  paymentMethod        PaymentMethod?
  codStatus            CodStatus?
  codCollectionId      String?
  codSettlementId      String?
  notes                String?
  postponedAt          DateTime?
  isFollowUp           Boolean              @default(false)
  pickupAddress        String
  dropoffAddress       String
  dropoffLatitude      Decimal              @db.Decimal(9, 6)
  dropoffLongitude     Decimal              @db.Decimal(9, 6)
  serviceType          String
  temperatureTarget    String
  etaMinutes           Int
  scheduledAt          DateTime
  assignedAt           DateTime?
  outForDeliveryAt     DateTime?
  arrivedAt            DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  logestechsOccurredAt DateTime?
  failureReason        String?
  isDelayed            Boolean              @default(false)
  requiresIntervention Boolean              @default(false)
  clientAccount        ClientAccount        @relation(fields: [clientAccountId], references: [id])
  customer             Customer             @relation(fields: [customerId], references: [id])
  courier              Courier?             @relation(fields: [courierId], references: [id])
  vehicle              Vehicle?             @relation(fields: [vehicleId], references: [id])
  hub                  Hub?                 @relation(fields: [hubId], references: [id])
  codCollection        CodCollection?       @relation(fields: [codCollectionId], references: [id])
  codSettlement        CodSettlement?       @relation(fields: [codSettlementId], references: [id])
  stops                DeliveryStop[]
  trackingSessions     TrackingSession[]
  otpCodes             OtpCode[]
  locationPings        LocationPing[]
  temperatureReadings  TemperatureReading[]
  notificationLogs     NotificationLog[]
  auditLogs            AuditLog[]
  proofOfDelivery      ProofOfDelivery?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, scheduledAt])
  @@index([courierId, status])
  @@index([codStatus])
}

model DeliveryStop {
  id          String        @id @default(cuid())
  orderId     String
  sequence    Int
  label       String
  address     String
  latitude    Decimal       @db.Decimal(9, 6)
  longitude   Decimal       @db.Decimal(9, 6)
  plannedAt   DateTime
  completedAt DateTime?
  order       DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TrackingSession {
  id                String        @id @default(cuid())
  orderId           String
  tokenHash         String        @unique
  expiresAt         DateTime
  usedAfterDelivery Boolean       @default(false)
  revokedAt         DateTime?
  order             DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@index([orderId, expiresAt])
}

model OtpCode {
  id          String        @id @default(cuid())
  orderId     String
  codeHash    String
  attempts    Int           @default(0)
  maxAttempts Int           @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  resentCount Int           @default(0)
  lastSentAt  DateTime?
  order       DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@index([orderId, expiresAt])
}

model LocationPing {
  id         String         @id @default(cuid())
  courierId  String
  orderId    String?
  latitude   Decimal        @db.Decimal(9, 6)
  longitude  Decimal        @db.Decimal(9, 6)
  speedKph   Decimal?       @db.Decimal(6, 2)
  heading    Int?
  battery    Int?
  recordedAt DateTime       @default(now())
  courier    Courier        @relation(fields: [courierId], references: [id], onDelete: Cascade)
  order      DeliveryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([courierId, recordedAt])
  @@index([orderId, recordedAt])
}

model TemperatureReading {
  id         String            @id @default(cuid())
  vehicleId  String
  orderId    String?
  celsius    Decimal           @db.Decimal(5, 2)
  status     TemperatureStatus @default(NORMAL)
  sensorId   String?
  recordedAt DateTime          @default(now())
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  order      DeliveryOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([vehicleId, recordedAt])
  @@index([orderId, recordedAt])
}

model NotificationLog {
  id          String              @id @default(cuid())
  orderId     String?
  channel     NotificationChannel
  recipient   String
  templateKey String
  payload     Json
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  sentAt      DateTime?
  error       String?
  order       DeliveryOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
}

model AuditLog {
  id        String         @id @default(cuid())
  orderId   String?
  actorId   String?
  action    AuditAction
  reason    String?
  metadata  Json?
  order     DeliveryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor     User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
}

// ─── Admin module (migrated from LogesTechs admin-pro spec) ───

model Hub {
  id          String          @id @default(cuid())
  name        String
  city        String
  address     String?
  managerName String?
  isActive    Boolean         @default(true)
  orders      DeliveryOrder[]
  couriers    Courier[]
  expenses    Expense[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// عهدة تحصيل COD المستلمة من المندوب (استلام التحصيلات)
model CodCollection {
  id          String          @id @default(cuid())
  courierId   String
  totalCod    Decimal         @db.Decimal(12, 2)
  totalFees   Decimal         @db.Decimal(12, 2)
  ordersCount Int             @default(0)
  receivedAt  DateTime?
  receivedBy  String?
  notes       String?
  courier     Courier         @relation(fields: [courierId], references: [id])
  orders      DeliveryOrder[]
  createdAt   DateTime        @default(now())

  @@index([courierId, receivedAt])
}

/// كشف تحصيل للعميل (مفرز -> مصدر -> مسلم)
model CodSettlement {
  id              String              @id @default(cuid())
  clientAccountId String
  status          CodSettlementStatus @default(SORTED)
  totalCod        Decimal             @db.Decimal(12, 2)
  totalFees       Decimal             @db.Decimal(12, 2)
  vatAmount       Decimal             @db.Decimal(12, 2)
  netToClient     Decimal             @db.Decimal(12, 2)
  sortedAt        DateTime            @default(now())
  exportedAt      DateTime?
  deliveredAt     DateTime?
  custodyReleased Boolean             @default(true)
  clientAccount   ClientAccount       @relation(fields: [clientAccountId], references: [id])
  orders          DeliveryOrder[]
  createdAt       DateTime            @default(now())

  @@index([clientAccountId, status])
}

model Expense {
  id        String      @id @default(cuid())
  type      ExpenseType
  amount    Decimal     @db.Decimal(12, 2)
  note      String?
  courierId String?
  hubId     String?
  hub       Hub?        @relation(fields: [hubId], references: [id])
  spentAt   DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([type, spentAt])
}

/// تسعير: قائمة أسعار (افتراضية للشركة أو مخصصة لعميل)
model PriceList {
  id              String      @id @default(cuid())
  name            String
  isDefault       Boolean     @default(false)
  clientAccountId String?     @unique
  prices          CityPrice[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CityPrice {
  id              String    @id @default(cuid())
  priceListId     String
  serviceType     String
  originCity      String
  destinationCity String
  price           Decimal   @db.Decimal(10, 2)
  returnPrice     Decimal?  @db.Decimal(10, 2)
  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceType, originCity, destinationCity])
}

model ProofOfDelivery {
  id           String        @id @default(cuid())
  orderId      String        @unique
  proofType    ProofType
  otpVerified  Boolean       @default(false)
  signatureUrl String?
  photoUrl     String?
  notes        String?
  capturedAt   DateTime      @default(now())
  order        DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String
  message   String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

// Durable normalized inbox. No provider customer/driver payload is retained.
model LogesTechsEvent {
  id              String    @id
  kind            String
  barcode         String
  externalStatus  String
  packageId       String?
  invoiceNumber   String?
  eventOccurredAt DateTime?
  eventReceivedAt DateTime  @default(now())
  state           String    @default("PENDING")
  outcome         String?
  orderId         String?
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  lastAttemptAt   DateTime?
  processedAt     DateTime?
  lastError       String?

  @@index([state, nextAttemptAt])
  @@index([barcode, eventOccurredAt])
}

model IntegrationJobRun {
  name            String    @id
  lastStartedAt   DateTime
  lastSucceededAt DateTime?
  lastError       String?
  processedCount  Int       @default(0)
}

model OperationalCase {
  owner                        User              @relation("CaseOwner", fields: [ownerId], references: [id])
  backupOwner                  User              @relation("CaseBackup", fields: [backupOwnerId], references: [id])
  clientAccount                ClientAccount     @relation(fields: [clientAccountId], references: [id])
  order                        DeliveryOrder?    @relation(fields: [orderId], references: [id])
  reopenedFrom                 OperationalCase?  @relation("CaseReopen", fields: [reopenedFromCaseId], references: [id])
  reopenedCases                OperationalCase[] @relation("CaseReopen")
  id                           String            @id @default(cuid())
  orderId                      String?
  clientAccountId              String
  caseType                     String
  priority                     String
  ownerId                      String
  backupOwnerId                String
  status                       String            @default("NEW")
  createdAt                    DateTime          @default(now())
  ackDueAt                     DateTime
  resolutionDueAt              DateTime
  lastActionAt                 DateTime          @default(now())
  resolution                   String?
  evidence                     Json              @default("[]")
  requiresCustomerConfirmation Boolean           @default(false)
  customerConfirmedAt          DateTime?
  closedAt                     DateTime?
  detectionKey                 String?           @unique
  escalationLevel              Int               @default(0)
  escalatedToUserId            String?
  reopenedFromCaseId           String?
  version                      Int               @default(0)

  @@index([status, resolutionDueAt])
  @@index([clientAccountId, status])
}

model ShipmentReconciliation {
  id               String   @id @default(cuid())
  clientAccountId  String
  source           String
  sourceCapturedAt DateTime
  windowStart      DateTime
  windowEnd        DateTime
  expectedCount    Int
  receivedCount    Int
  matchedCount     Int
  missingIds       Json
  duplicateIds     Json
  unexpectedIds    Json
  complete         Boolean
  sourceHash       String
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([clientAccountId, createdAt])
}

model OperationsPolicy {
  id                      String   @id @default(cuid())
  clientAccountId         String   @unique
  ownerId                 String
  backupOwnerId           String
  firstEscalationOwnerId  String
  secondEscalationOwnerId String
  ackMinutes              Int
  resolutionMinutes       Int
  stalledMinutes          Int
  noUpdateMinutes         Int
  riskMinutes             Int
  driverCapacity          Int?
  updatedBy               String
  updatedAt               DateTime @updatedAt
}

model DeliveryCommitment {
  id              String   @id @default(cuid())
  orderId         String
  clientAccountId String
  ownerId         String
  windowStart     DateTime
  windowEnd       DateTime
  planReference   String
  feasibility     String   @default("NEEDS_REVIEW")
  status          String   @default("PLANNED")
  result          String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, windowEnd])
}
