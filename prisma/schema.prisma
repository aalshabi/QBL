// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  OPS_MANAGER
  DISPATCHER
  COURIER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ClientSector {
  FOOD_SUPPLIER
  PHARMACY_CLINIC
  RESTAURANT_CAFE
  RETAIL
  HOTEL_HOSPITAL
  ECOMMERCE
}

enum CourierStatus {
  AVAILABLE
  ON_TASK
  LATE
  OFFLINE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

enum OrderStatus {
  CREATED
  PENDING_APPROVAL
  ASSIGNED
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  POSTPONED
  RETURNED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MADA
  VISA
  MASTER
  PREPAID
}

enum CodStatus {
  WITH_COURIER
  RECEIVED
  SORTED
  EXPORTED
  SETTLED
}

enum CodSettlementStatus {
  SORTED
  EXPORTED
  DELIVERED
}

enum ExpenseType {
  DRIVER
  HUB
  PARTNER
  OTHER
}

/// ما عرفه التشغيل عن حرارة الشحنة لحظة تسليمها. MISSING ليست عطلاً في
/// السجل بل حقيقة عنه: طلب أُغلق ولا أحد يعرف حرارته.
enum TemperatureEvidence {
  IN_RANGE
  OUT_OF_RANGE
  STALE
  MISSING
}

enum ColdChainAlertKind {
  OUT_OF_RANGE
  STALE_READING
  NO_TELEMETRY
}

enum TemperatureStatus {
  NORMAL
  WARNING
  CRITICAL
  NOT_AVAILABLE
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  INTERNAL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum WhatsAppConfirmationStatus {
  PENDING
  CONFIRMED
  RESCHEDULE_REQUESTED
  DECLINED
  NO_REPLY
  MANUAL_REVIEW
  OPTED_OUT
}

enum WhatsAppCommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum WhatsAppOpsAlertKind {
  DELIVERY_UNKNOWN
  EARLY_WARNING
  NO_RESPONSE
  SEND_FAILED
  NEEDS_REVIEW
}

enum WhatsAppOpsAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  DEAD_LETTER
}

enum WhatsAppOutboxStatus {
  QUEUED
  LEASED
  SENT
  RETRY
  DEAD_LETTER
  CANCELLED
}

enum AuditAction {
  ORDER_CREATED
  ORDER_ASSIGNED
  ORDER_REASSIGNED
  STATUS_CHANGED
  OTP_GENERATED
  OTP_RESENT
  OTP_VERIFIED
  OTP_FAILED
  OTP_MANUAL_OVERRIDE
  LOCATION_PING
  TEMPERATURE_READING
  POD_CAPTURED
  PASSWORD_CHANGED
  WHATSAPP_MANUAL_REPLY_QUEUED
  WHATSAPP_OPS_ALERT_CREATED
  WHATSAPP_OPS_REVIEWED
}

enum ProofType {
  OTP
  SIGNATURE
  PHOTO
  MANUAL_OVERRIDE
}

model Company {
  id             String   @id @default(cuid())
  officialName   String
  tradeName      String
  abbreviation   String
  sector         String
  headquarters   String
  foundedYear    Int
  website        String
  generalEmail   String
  salesEmail     String
  opsEmail       String
  billingEmail   String
  generalManager String
  managerEmail   String
  address        String
  crNumber       String
  unifiedNumber  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String
  status       UserStatus     @default(ACTIVE)
  roles        UserRole[]
  courier      Courier?
  client       ClientAccount?
  auditLogs    AuditLog[]     @relation("AuditActor")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Shared password-change attempt counter. It lives in Postgres so all
/// serverless instances enforce the same five-attempt window.
model PasswordChangeRateLimit {
  userId    String   @id
  attempts  Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String          @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String
  latitude  Decimal         @db.Decimal(9, 6)
  longitude Decimal         @db.Decimal(9, 6)
  sector    ClientSector
  orders    DeliveryOrder[]
  whatsappConsents WhatsAppConsent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ClientAccount {
  id             String          @id @default(cuid())
  userId         String?         @unique
  companyName    String
  contactName    String
  contactEmail   String
  contactPhone   String
  sector         ClientSector
  slaMinutes     Int             @default(120)
  billingEmail   String?
  user           User?           @relation(fields: [userId], references: [id])
  orders         DeliveryOrder[]
  codSettlements CodSettlement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Courier {
  id             String          @id @default(cuid())
  userId         String?         @unique
  employeeCode   String          @unique
  displayName    String
  phone          String
  status         CourierStatus   @default(AVAILABLE)
  vehicleId      String?         @unique
  hubId          String?
  user           User?           @relation(fields: [userId], references: [id])
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  hub            Hub?            @relation(fields: [hubId], references: [id])
  orders         DeliveryOrder[]
  pings          LocationPing[]
  codCollections CodCollection[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Vehicle {
  id               String               @id @default(cuid())
  plateNumber      String               @unique
  label            String
  make             String
  model            String
  year             Int
  coldRangeMin     Decimal              @db.Decimal(5, 2)
  coldRangeMax     Decimal              @db.Decimal(5, 2)
  supportsFrozen   Boolean              @default(false)
  status           VehicleStatus        @default(ACTIVE)
  insuranceExpiry  DateTime?
  licenseExpiry    DateTime?
  courier          Courier?
  orders           DeliveryOrder[]
  temperatures     TemperatureReading[]
  coldChainAlerts  ColdChainAlert[]
  coldChainSensors ColdChainSensor[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model DeliveryOrder {
  id                   String               @id @default(cuid())
  publicCode           String               @unique
  reference            String               @unique
  barcode              String?              @unique
  clientAccountId      String
  customerId           String
  courierId            String?
  vehicleId            String?
  hubId                String?
  status               OrderStatus          @default(CREATED)
  codAmount            Decimal?             @db.Decimal(10, 2)
  deliveryFee          Decimal?             @db.Decimal(10, 2)
  paymentMethod        PaymentMethod?
  codStatus            CodStatus?
  codCollectionId      String?
  codSettlementId      String?
  notes                String?
  postponedAt          DateTime?
  isFollowUp           Boolean              @default(false)
  pickupAddress        String
  dropoffAddress       String
  dropoffLatitude      Decimal              @db.Decimal(9, 6)
  dropoffLongitude     Decimal              @db.Decimal(9, 6)
  serviceType          String
  temperatureTarget    String
  etaMinutes           Int
  scheduledAt          DateTime
  assignedAt           DateTime?
  outForDeliveryAt     DateTime?
  arrivedAt            DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  failureReason        String?
  isDelayed            Boolean              @default(false)
  requiresIntervention Boolean              @default(false)
  clientAccount        ClientAccount        @relation(fields: [clientAccountId], references: [id])
  customer             Customer             @relation(fields: [customerId], references: [id])
  courier              Courier?             @relation(fields: [courierId], references: [id])
  vehicle              Vehicle?             @relation(fields: [vehicleId], references: [id])
  hub                  Hub?                 @relation(fields: [hubId], references: [id])
  codCollection        CodCollection?       @relation(fields: [codCollectionId], references: [id])
  codSettlement        CodSettlement?       @relation(fields: [codSettlementId], references: [id])
  stops                DeliveryStop[]
  trackingSessions     TrackingSession[]
  otpCodes             OtpCode[]
  locationPings        LocationPing[]
  temperatureReadings  TemperatureReading[]
  notificationLogs     NotificationLog[]
  auditLogs            AuditLog[]
  proofOfDelivery      ProofOfDelivery?
  coldChainAlerts      ColdChainAlert[]
  whatsappConfirmations WhatsAppConfirmation[]
  whatsappMessages      WhatsAppMessage[]
  whatsappOutbox        WhatsAppOutbox[]
  whatsappOpsAlerts     WhatsAppOpsAlert[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, scheduledAt])
  @@index([courierId, status])
  @@index([codStatus])
}

model WhatsAppConsent {
  id          String   @id @default(cuid())
  customerId  String
  phoneE164   String
  purpose     String
  source      String
  grantedAt   DateTime
  revokedAt   DateTime?
  evidenceRef String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneE164, revokedAt])
  @@index([customerId, grantedAt])
}

model WhatsAppConfirmation {
  id                String                     @id @default(cuid())
  orderId           String
  version           Int                        @default(1)
  phoneE164         String
  status            WhatsAppConfirmationStatus @default(PENDING)
  communicationStatus WhatsAppCommunicationStatus @default(QUEUED)
  requestedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  earlyWarningAt    DateTime?
  responseDeadlineAt DateTime?
  respondedAt       DateTime?
  requestedTimeText String?
  lastInboundAt     DateTime?
  manualReviewAt    DateTime?
  optedOutAt        DateTime?
  opsReviewedAt     DateTime?
  opsDecision       String?
  opsReason         String?
  courierIdSnapshot String?
  order             DeliveryOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages          WhatsAppMessage[]
  outbox            WhatsAppOutbox[]
  opsAlerts         WhatsAppOpsAlert[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([orderId, version])
  @@index([phoneE164, status, createdAt])
  @@index([status, updatedAt])
}

model WhatsAppOpsAlert {
  id                String                 @id @default(cuid())
  confirmationId    String
  orderId           String
  kind              WhatsAppOpsAlertKind
  status            WhatsAppOpsAlertStatus @default(OPEN)
  dueAt             DateTime?
  courierIdSnapshot String?
  detailsHash       String
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  confirmation      WhatsAppConfirmation   @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  order             DeliveryOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([confirmationId, kind])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

model WhatsAppMessage {
  id               String                   @id @default(cuid())
  providerMessageId String?                  @unique
  orderId          String?
  confirmationId   String?
  direction        WhatsAppMessageDirection
  status           WhatsAppMessageStatus
  phoneE164        String
  messageType      String
  bodyRedacted     String?
  payloadHash      String
  providerTimestamp DateTime?
  errorCode        String?
  errorSummary     String?
  order            DeliveryOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  confirmation     WhatsAppConfirmation?      @relation(fields: [confirmationId], references: [id], onDelete: SetNull)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([phoneE164, createdAt])
  @@index([orderId, createdAt])
}

model WhatsAppWebhookEvent {
  id          String    @id
  payloadHash String
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
}

model WhatsAppOutbox {
  id              String               @id @default(cuid())
  idempotencyKey  String               @unique
  orderId         String
  confirmationId  String
  phoneE164       String
  templateName    String
  templateLanguage String              @default("ar")
  parameters      Json
  status          WhatsAppOutboxStatus @default(QUEUED)
  attemptCount    Int                  @default(0)
  nextAttemptAt   DateTime             @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  providerMessageId String?
  lastError       String?
  sentAt          DateTime?
  expiresAt       DateTime?
  order           DeliveryOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  confirmation    WhatsAppConfirmation  @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model DeliveryStop {
  id          String        @id @default(cuid())
  orderId     String
  sequence    Int
  label       String
  address     String
  latitude    Decimal       @db.Decimal(9, 6)
  longitude   Decimal       @db.Decimal(9, 6)
  plannedAt   DateTime
  completedAt DateTime?
  order       DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TrackingSession {
  id                String        @id @default(cuid())
  orderId           String
  tokenHash         String        @unique
  expiresAt         DateTime
  usedAfterDelivery Boolean       @default(false)
  revokedAt         DateTime?
  order             DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@index([orderId, expiresAt])
}

model OtpCode {
  id          String        @id @default(cuid())
  orderId     String
  codeHash    String
  attempts    Int           @default(0)
  maxAttempts Int           @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  resentCount Int           @default(0)
  lastSentAt  DateTime?
  order       DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@index([orderId, expiresAt])
}

model LocationPing {
  id         String         @id @default(cuid())
  courierId  String
  orderId    String?
  latitude   Decimal        @db.Decimal(9, 6)
  longitude  Decimal        @db.Decimal(9, 6)
  speedKph   Decimal?       @db.Decimal(6, 2)
  heading    Int?
  battery    Int?
  recordedAt DateTime       @default(now())
  courier    Courier        @relation(fields: [courierId], references: [id], onDelete: Cascade)
  order      DeliveryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([courierId, recordedAt])
  @@index([orderId, recordedAt])
}

model TemperatureReading {
  id         String            @id @default(cuid())
  vehicleId  String
  orderId    String?
  celsius    Decimal           @db.Decimal(5, 2)
  status     TemperatureStatus @default(NORMAL)
  sensorId   String?
  // وقت القياس عند المستشعر، ووقت وصوله إلينا. الفارق بينهما هو ما يكشف
  // تأخر المزود: قراءة عمرها ساعة وصلت الآن ليست قراءة حديثة.
  recordedAt DateTime          @default(now())
  receivedAt DateTime          @default(now())
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  order      DeliveryOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([vehicleId, recordedAt])
  @@index([orderId, recordedAt])
}

model NotificationLog {
  id          String              @id @default(cuid())
  orderId     String?
  channel     NotificationChannel
  recipient   String
  templateKey String
  payload     Json
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  sentAt      DateTime?
  error       String?
  order       DeliveryOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
}

model AuditLog {
  id        String         @id @default(cuid())
  orderId   String?
  actorId   String?
  action    AuditAction
  reason    String?
  metadata  Json?
  order     DeliveryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor     User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
}

/// صندوق وارد خام لأحداث ويبهوك LogesTechs: يُحفظ كل حدث قبل معالجته، فلا يضيع حدث
/// لشحنة غير موجودة بعد في QBL، ويمكن إعادة معالجته أو مطابقته لاحقًا عبر الباركود.
/// المعرّف هو معرّف الحدث الحتمي (ltwh_…) فيمنع التكرار.
/// لا بيانات شخصية: لا اسم سائق ولا جوال ولا مرفقات ولا حمولة خام.
model LogesTechsWebhookEvent {
  id             String    @id
  kind           String
  barcode        String
  externalStatus String
  packageId      String?
  invoiceNumber  String?
  externalTime   DateTime?
  notes          String?
  codAmount      Decimal?  @db.Decimal(10, 2)
  outcome        String?
  orderId        String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([barcode, receivedAt])
  @@index([processedAt])
}

// ─── Admin module (migrated from LogesTechs admin-pro spec) ───

model Hub {
  id          String          @id @default(cuid())
  name        String
  city        String
  address     String?
  managerName String?
  isActive    Boolean         @default(true)
  orders      DeliveryOrder[]
  couriers    Courier[]
  expenses    Expense[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// عهدة تحصيل COD المستلمة من المندوب (استلام التحصيلات)
model CodCollection {
  id          String          @id @default(cuid())
  courierId   String
  totalCod    Decimal         @db.Decimal(12, 2)
  totalFees   Decimal         @db.Decimal(12, 2)
  ordersCount Int             @default(0)
  receivedAt  DateTime?
  receivedBy  String?
  notes       String?
  courier     Courier         @relation(fields: [courierId], references: [id])
  orders      DeliveryOrder[]
  createdAt   DateTime        @default(now())

  @@index([courierId, receivedAt])
}

/// كشف تحصيل للعميل (مفرز -> مصدر -> مسلم)
model CodSettlement {
  id              String              @id @default(cuid())
  clientAccountId String
  status          CodSettlementStatus @default(SORTED)
  totalCod        Decimal             @db.Decimal(12, 2)
  totalFees       Decimal             @db.Decimal(12, 2)
  vatAmount       Decimal             @db.Decimal(12, 2)
  netToClient     Decimal             @db.Decimal(12, 2)
  sortedAt        DateTime            @default(now())
  exportedAt      DateTime?
  deliveredAt     DateTime?
  custodyReleased Boolean             @default(true)
  clientAccount   ClientAccount       @relation(fields: [clientAccountId], references: [id])
  orders          DeliveryOrder[]
  createdAt       DateTime            @default(now())

  @@index([clientAccountId, status])
}

model Expense {
  id        String      @id @default(cuid())
  type      ExpenseType
  amount    Decimal     @db.Decimal(12, 2)
  note      String?
  courierId String?
  hubId     String?
  hub       Hub?        @relation(fields: [hubId], references: [id])
  spentAt   DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([type, spentAt])
}

/// تسعير: قائمة أسعار (افتراضية للشركة أو مخصصة لعميل)
model PriceList {
  id              String      @id @default(cuid())
  name            String
  isDefault       Boolean     @default(false)
  clientAccountId String?     @unique
  prices          CityPrice[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CityPrice {
  id              String    @id @default(cuid())
  priceListId     String
  serviceType     String
  originCity      String
  destinationCity String
  price           Decimal   @db.Decimal(10, 2)
  returnPrice     Decimal?  @db.Decimal(10, 2)
  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceType, originCity, destinationCity])
}

model ProofOfDelivery {
  id                  String              @id @default(cuid())
  orderId             String              @unique
  proofType           ProofType
  otpVerified         Boolean             @default(false)
  // دليل سلسلة التبريد وقت الإغلاق. إثبات تسليم لا يقول شيئاً عن الحرارة
  // ليس إثباتاً لشحنة مبرّدة.
  temperatureEvidence TemperatureEvidence @default(MISSING)
  temperatureCelsius  Decimal?            @db.Decimal(5, 2)
  temperatureAt       DateTime?
  signatureUrl        String?
  photoUrl            String?
  notes               String?
  capturedAt          DateTime            @default(now())
  order               DeliveryOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String
  message   String
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

/// إنذار سلسلة التبريد. القراءات وحدها لا تحمي شحنة: ما يحميها هو أن الخرق
/// يصير حالة مفتوحة يراها التشغيل ويغلقها، لا سطراً في جدول قياسات.
/// إنذار واحد مفتوح لكل (طلب، نوع): تكرار الخرق يرفع العدّاد ولا ينشئ صفاً.
model ColdChainAlert {
  id          String             @id @default(cuid())
  orderId     String?
  vehicleId   String?
  kind        ColdChainAlertKind
  severity    TemperatureStatus  @default(WARNING)
  celsius     Decimal?           @db.Decimal(5, 2)
  boundsMin   Decimal?           @db.Decimal(5, 2)
  boundsMax   Decimal?           @db.Decimal(5, 2)
  occurrences Int                @default(1)
  detectedAt  DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())
  readingAt   DateTime?
  resolvedAt  DateTime?
  note        String?
  order       DeliveryOrder?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())

  @@index([orderId, kind, resolvedAt])
  @@index([resolvedAt, detectedAt])
}

/// سجل أجهزة سلسلة التبريد. بدونه كان أي حامل لمفتاح الويبهوك يكتب قراءة
/// بأي معرّف مستشعر لأي مركبة، ولا سبيل للتمييز بين «جهاز تعطّل» و«جهاز لم
/// يوجد قط». التسجيل هو ما يحوّل نقطة الاستقبال إلى تكامل: جهاز معروف،
/// مربوط بمركبة، تابع لمزود مسمّى، ويُعرف متى صمت.
model ColdChainSensor {
  id           String    @id @default(cuid())
  sensorId     String    @unique
  provider     String
  vehicleId    String?
  label        String?
  active       Boolean   @default(true)
  registeredAt DateTime  @default(now())
  lastSeenAt   DateTime?
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([active, lastSeenAt])
}
