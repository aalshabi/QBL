DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qdl?schema=public"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-session-secret"
TRACKING_TOKEN_SECRET="replace-with-a-long-random-tracking-secret"
OTP_PEPPER="replace-with-a-long-random-otp-pepper"
MAP_PROVIDER="mock"
# Server-only. Restricted to Places API (New); never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
SMS_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"

# LogesTechs server-only integration. Never prefix these with NEXT_PUBLIC_.
LOGESTECHS_BASE_URL=""
LOGESTECHS_COMPANY_ID=""
LOGESTECHS_EMAIL=""
LOGESTECHS_PASSWORD=""
# Inbound status webhook authentication. Server-only; use a random value of at least 32 characters.
LOGESTECHS_WEBHOOK_API_KEY=""
# Development/test only. Production is pinned to apisv2.logestechs.com.
LOGESTECHS_ALLOWED_HOSTS=""

# Provider-agnostic vehicle temperature/GPS telemetry webhook. No refrigeration/IoT
# vendor is connected yet — set this once one is contracted and point their webhook
# at /api/webhooks/cold-chain-telemetry. Server-only; random value of at least 32 characters.
COLD_CHAIN_TELEMETRY_API_KEY=""

# Client-side Google Maps JavaScript API key for the public tracking page's live map.
# Must be a SEPARATE key from GOOGLE_MAPS_API_KEY above, with "Maps JavaScript API"
# enabled and restricted by HTTP referrer in Google Cloud Console to this site's
# domain, since it is sent to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# Bearer secret required by scheduled/cron endpoints (e.g. the daily temperature report).
CRON_SECRET=""

# تنبيه العملاء المحتملين — يُرسل فور وصول طلب عرض سعر من الموقع.
# بلا تهيئة تُحفظ الطلبات في قاعدة البيانات وتظهر في /admin/leads، لكن لا يصل إشعار
# (تُسجَّل الحالة SKIPPED صراحة ولا يُدّعى الإرسال).
LEAD_ALERT_PROVIDER=""
RESEND_API_KEY=""
# وجهة التنبيه. الافتراضي sales@qbl.sa من lib/site.ts.
LEAD_ALERT_EMAIL=""
# المرسِل كما يظهر للمستقبِل. يجب أن يكون نطاقاً موثّقاً لدى المزوّد.
LEAD_ALERT_FROM=""
